NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://livestock:REPLACE_WITH_STRONG_DB_PASSWORD@db-host:5432/livestock
REDIS_URL=redis://redis-host:6379
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_STRONG_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BOOTSTRAP_ADMIN=false
ANIMALS_CSV_PATH=./data/ANIMAL_REG - data.csv
OPENAPI_ENABLED=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
CORS_ORIGIN=https://your-lan-host
