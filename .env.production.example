NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# DOTENV
# ALLOW_DOTENV=true  # set only if you intentionally load .env in production

# DATABASE / REDIS
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://HOST:6379

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET   # use 32+ random chars
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET # use 32+ random chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# FEATURE FLAGS
OPENAPI_ENABLED=false
BOOTSTRAP_ADMIN=false

# RATE LIMITING
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

# CORS
CORS_ORIGIN=https://your-frontend-domain

# SEED / DATA
ANIMALS_CSV_PATH=./data/ANIMAL_REG - data.csv
AUTO_MIGRATE=false
AUTO_SEED=false
