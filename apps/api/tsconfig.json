{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "composite": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "paths": {
      "@livestock/shared/*": ["../../packages/shared/src/*"],
      "@livestock/shared": ["../../packages/shared/src"],
      "@livestock/db": ["../../packages/db/src"],
      "@livestock/db/*": ["../../packages/db/src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
